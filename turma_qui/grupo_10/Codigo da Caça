char randon() {
	int resul;

	resul=rand()%100;

	if(resul<=25) {
		return 'e';
	} else if(resul>25 && resul<=50) {
		return 'd';
	} else if(resul>50 && resul<=75) {
		return 'c';
	} else if(resul>75 && resul<=100) {
		return 'b';
	}

	return ' ';

}

void randonspawn(int spaces, char map[spaces][spaces]) {
	for(int i=0; i<lbtt; i++) {

		do {
			lobos[i].x = rand()%spaces;
			lobos[i].y = rand()%spaces;
		} while(map[lobos[i].x][lobos[i].y] != ' ');
		map[lobos[i].x][lobos[i].y] = 'l';
		lobos[i].vivo=1;
	}

	for(int i=0; i<ott; i++) {

		do {
			ovelhas[i].x = rand()%spaces;
			ovelhas[i].y = rand()%spaces;
		} while(map[ovelhas[i].x][ovelhas[i].y] != ' ');
		map[ovelhas[i].x][ovelhas[i].y] = 'o';
		ovelhas[i].vivo=1;
	}

	for(int i=0; i<ctt; i++) {

		do {
			cacadores[i].x = rand()%spaces;
			cacadores[i].y = rand()%spaces;
		} while(map[cacadores[i].x][cacadores[i].y] != ' ');
		map[cacadores[i].x][cacadores[i].y] = 'c';
		cacadores[i].vivo=1;
	}

	for(int i=0; i<artt; i++) {

		do {
			arvores[i].x = rand()%spaces;
			arvores[i].y = rand()%spaces;
		} while(map[arvores[i].x][arvores[i].y] != ' ');
		map[arvores[i].x][arvores[i].y] = 'a';

	}
	
	for(int i=0; i<artt; i++) {

		do {
			casas[i].x = rand()%spaces;
			casas[i].y = rand()%spaces;
		} while(map[casas[i].x][casas[i].y] != ' ');
		map[casas[i].x][casas[i].y] = 'h';

	}
}

entidade movimentacao(entidade e, int spaces, char map[spaces][spaces]) {

	int poss;
	
	poss = randon();

	if(poss=='e') {
		if(e.y<1) {
			e.y++;
		} else {
			e.y--;
		}
	} else if(poss=='d') {
		if(e.y==spaces-1) {
			e.y--;
		} else {
			e.y++;
		}
	} else if(poss=='c') {
		if(e.x<1) {
			e.x++;
		} else {
			e.x--;
		}
	} else if(poss=='b') {

		if(e.x==spaces-1) {
			e.x--;
		} else {
			e.x++;
		}
		
	}
    
    
	return e;

}

entidade interacoes(int spaces, char map[spaces][spaces]){
    
    for(int i=0; i<lbtt; i++){
        for(int j=0; j<ott; j++){
            
            if(!ovelhas[j].vivo)
            continue;
            
            if(lobos[i].x == ovelhas[j].x && lobos[i].y == ovelhas[j].y){
                ovelhas[j].vivo = 0;
            }
        }
    }
    
    for(int i=0; i<ott; i++){
        for(int j=0; j<ott; j++){
            
            if(!ovelhas[j].vivo)
            continue;
            
            if(i!=j && ovelhas[i].x == ovelhas[j].x && ovelhas[i].y == ovelhas[j].y){
                if(ovelhas[i].reproducao==1 || ovelhas[j].reproducao==1)continue;
                if(ott<MAX_OV){
                    ovelhas[i].reproducao=1;
                    ovelhas[j].reproducao=1;
                    ovelhas[ott].x = ovelhas[i].velhox;
                    ovelhas[ott].y = ovelhas[i].velhoy;
                    ovelhas[ott].vivo = 1;
                    ott++;
                }
            }
        }
    }
    
    for(int i=0; i<lbtt; i++){
        for(int j=i+1; j<lbtt; j++){
            
            if(!lobos[i].vivo)
            continue;
            
            if( i!=j && lobos[i].x == lobos[j].x && lobos[i].y == lobos[j].y){
                if(lobos[i].reproducao==1)continue;
                if(lbtt<MAX_LOB){
                    lobos[i].reproducao=1;
                    lobos[lbtt].x = lobos[i].velhox;
                    lobos[lbtt].y = lobos[i].velhoy;
                    lobos[lbtt].vivo = 1;
                    lbtt++;
                }
                
            }
        }
    }
    
    for(int i=0; i<lbtt; i++){
        for(int j=0; j<ctt; j++){
            
            if(!lobos[i].vivo)
            continue;
            
            if(cacadores[j].x == lobos[i].x && cacadores[j].y == lobos[i].y){
                lobos[i].vivo = 0;
            }
        }
    }
    
    for(int i=0; i<ott; i++){
        for(int j=0; j<artt; j++){
            
            if(ovelhas[i].x == arvores[j].x && ovelhas[i].y == arvores[j].y){
                ovelhas[i].x = ovelhas[i].velhox;
                ovelhas[i].y = ovelhas[i].velhoy;
            }
        }
    }
    
    for(int i=0; i<lbtt; i++){
        for(int j=0; j<artt; j++){
            
            if(lobos[i].x == arvores[j].x && lobos[i].y == arvores[j].y){
                lobos[i].x = lobos[i].velhox;
                lobos[i].y = lobos[i].velhoy;
            }
        }
    }
    
    for(int i=0; i<ctt; i++){
        for(int j=0; j<artt; j++){
            
            if(cacadores[i].x == arvores[j].x && cacadores[i].y == arvores[j].y){
                cacadores[i].x = cacadores[i].velhox;
                cacadores[i].y = cacadores[i].velhoy;
            }
        }
    }
    
    for(int i=0; i<ctt; i++){
        for(int j=0; j<cstt; j++){
            
            if(cacadores[i].x == casas[j].x && cacadores[i].y == casas[j].y){
                if(cacadores[i].reproducao==1)continue;
                if(ctt<MAX_LOB){
                    cacadores[i].reproducao=1;
                    cacadores[ctt].x = cacadores[i].velhox;
                    cacadores[ctt].y = cacadores[i].velhoy;
                    cacadores[ctt].vivo = 1;
                    ctt++;
                }
            }
        }
    }
}

int vitoria(){
    
    int ovi=0;
    int lvi=0;
    
    for(int i=0; i<ott; i++){
        if(ovelhas[i].vivo == 1){
            ovi++;
        }
    }
    
    for(int i=0; i<lbtt; i++){
       if(lobos[i].vivo == 1){
           lvi++;
       }
    }
    
    if(ovi == 0){
        system("clear");
        printf("###########################\n");
        printf("#                         #\n");
        printf("#   Os Lobos Venceram!!   #\n");
        printf("#                         #\n");
